  "method_contract": {
    "entry_baseline_method": "rolling_tr_sum",
    "baseline_window": "exactly BH finite TR15 atoms ending at or before strict H inside one continuous segment and available by the current calculation time under the selected policy",
    "baseline_sampling_policies": {
      "all_window": "every finite TR15 atom is eligible and markers remain audit/chart evidence",
      "exclude_marked": "an atom enters baseline only when baseline_available_from is no later than the current calculation time; recovered buffers enter at recovery confirmation; confirmed exclusions never enter",
      "confirmed_low_activity_gate": "default; pending atoms remain eligible, then confirmation excludes the run from its first atom for later baselines and gates new entries until normal volume returns"
    },
    "rebound_baseline": {
      "policy_id": "max_completed_w_h_bounded_open_to_low_v2",
      "semantic_name": "w_open_to_end_low_drop",
      "candidate": "w_open_to_end_low_drop=open[start]-low[end] with start=max(H, continuity start, end-W+1)",
      "window_length_policy": "available_prefix_1_to_W",
      "full_w_required": false,
      "minimum_window_ratio": 0.0,
      "early_prefix_maximum_can_govern_trade": true,
      "internal_maximum_ordered_decline": false,
      "effective_timing": "a completed bar candidate becomes eligible on the next bar",
      "aggregation": "monotonic maximum within one actual position",
      "entry_reset": "clear all max-W state at every actual entry",
      "raw_compatibility": "legacy rebound_max_w_drop and candidate audit field names remain unchanged"
    },
